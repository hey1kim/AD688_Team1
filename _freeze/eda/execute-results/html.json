ustry\"},\"categoryorder\":\"total ascending\"},\"legend\":{\"tracegroupgap\":0},\"title\":{\"text\":\"Top Industries for AI-Related Job Postings\"},\"barmode\":\"relative\"},                        {\"responsive\": true}                    ).then(function(){\n                            \nvar gd = document.getElementById('15f7c024-e4f8-4241-8d9c-3e3f305e2106');\nvar x = new MutationObserver(function (mutations, observer) {{\n        var display = window.getComputedStyle(gd).display;\n        if (!display || display === 'none') {{\n            console.log([gd, 'removed!']);\n            Plotly.purge(gd);\n            observer.disconnect();\n        }}\n}});\n\n// Listen for the removal of the full notebook cells\nvar notebookContainer = gd.closest('#notebook-container');\nif (notebookContainer) {{\n    x.observe(notebookContainer, {childList: true});\n}}\n\n// Listen for the clearing of the current output cell\nvar outputEl = gd.closest('.output');\nif (outputEl) {{\n    x.observe(outputEl, {childList: true});\n}}\n\n                        })                };            </script>        </div>\n```\n:::\n:::\n\n\n**Key insight:** AI-related postings are most common in Professional, Scientific, and Technical Services, Finance and Insurance, Manufacturing, Information, Educational Services, Retail Trade, and Health Care and Social Assistance. These results suggest that AI-related hiring is more visible in industries that rely heavily on technical, analytical, financial, and service-related work. This graph shows where AI-related job demand appears in the dataset, but it does not directly show whether AI is replacing jobs.\n\n## Top Skills Required in AI-Related Job Postings\n\nThis visualization identifies the most frequently listed skills in AI-related job postings. It was chosen because skill demand helps explain how AI-related careers differ from broader non-AI roles. This also helps show what technical and business skills job seekers may need to prepare for AI-related career opportunities.\n\n::: {#29dabc26 .cell execution_count=5}\n``` {.python .cell-code}\nai_jobs = df[df[\"AI_RELATED\"]].copy()\n\nskill_text = (\n    ai_jobs[\"SKILLS_NAME\"].fillna(\"\") + \",\" +\n    ai_jobs[\"SPECIALIZED_SKILLS_NAME\"].fillna(\"\") + \",\" +\n    ai_jobs[\"SOFTWARE_SKILLS_NAME\"].fillna(\"\")\n)\n\nskills = (\n    skill_text\n    .str.split(\",\")\n    .explode()\n    .str.strip()\n)\n\n# Clean formatting artifacts from list-like strings\nskills = (\n    skills\n    .str.replace(r'[\\[\\]\\n]', '', regex=True)\n    .str.replace('\"', '', regex=False)\n    .str.strip()\n)\n\nskills = skills[skills != \"\"]\n\ntop_skills = (\n    skills\n    .value_counts()\n    .head(20)\n    .reset_index()\n)\n\ntop_skills.columns = [\"Skill\", \"Frequency\"]\n\nfig = px.bar(\n    top_skills,\n    x=\"Frequency\",\n    y=\"Skill\",\n    orientation=\"h\",\n    title=\"Top Skills Required in AI-Related Job Postings\"\n)\n\nfig.update_layout(yaxis={\"categoryorder\": \"total ascending\"})\nfig.show()\n```\n\n::: {.cell-output .cell-output-display}\n```{=html}\n<div style=\"height:525px; width:100%;\">            <script src=\"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.5/MathJax.js?config=TeX-AMS-MML_SVG\"></script><script>if (window.MathJax && window.MathJax.Hub && window.MathJax.Hub.Config) {window.MathJax.Hub.Config({SVG: {font: \"STIX-Web\"}});}</script>                <script>window.PlotlyConfig = {MathJaxConfig: 'local'};</script>\n        <script charset=\"utf-8\" src=\"https://cdn.plot.ly/plotly-3.6.0.min.js\" integrity=\"sha256-QaOVwtVY0T02VaHrr6pnoHLCwayMJp4O5n4YyaE3rJk=\" crossorigin=\"anonymous\"></script>                <div id=\"be8fb129-2624-4378-9ebd-b53b3bc4be39\" class=\"plotly-graph-div\" style=\"height:100%; width:100%;\"></div>            <script>                window.PLOTLYENV=window.PLOTLYENV || {};                                if (document.getElementById(\"be8fb129-2624-4378-9ebd-b53b3bc4be39\")) {                    P